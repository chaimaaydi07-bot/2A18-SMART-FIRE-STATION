  <property name="styleSheet">
   <string notr="true">
QMainWindow {
    background: #f5f7fb;
}

QWidget {
    font-family: Arial;
    font-size: 12px;
    color: #0f1b2d;
}

QFrame#sidebar {
    background: #d80000;
}

QLabel#logo {
    background: white;
    border: 3px solid white;
    border-radius: 8px;
}

QPushButton[nav=&quot;true&quot;] {
    color: white;
    background: transparent;
    border: none;
    border-radius: 7px;
    padding: 12px 14px;
    text-align: left;
    font-weight: bold;
}

QPushButton[nav=&quot;true&quot;]:hover {
    background: #ef1d1d;
}

QPushButton[nav=&quot;true&quot;]:checked {
    background: #ff3333;
}

QLabel#pageTitle {
    font-size: 25px;
    font-weight: bold;
}

QLabel#pageSubtitle {
    color: #617085;
}

QLabel[class=&quot;cardTitle&quot;] {
    font-size: 15px;
    font-weight: bold;
}

QFrame[class=&quot;card&quot;] {
    background: white;
    border: 1px solid #e2e7ef;
    border-radius: 8px;
}

QLineEdit,
QComboBox {
    min-height: 24px;
    border: 1px solid #cfd8e6;
    border-radius: 5px;
    padding-left: 8px;
    background: white;
}

QLineEdit:hover,
QComboBox:hover {
    border: 1px solid #90a7c8;
}

QPushButton {
    border-radius: 6px;
    font-weight: bold;
}

QPushButton#exportButton {
    color: #008242;
    background: white;
    border: 1px solid #99dfbd;
    padding: 7px 18px;
}

QPushButton#exportButton:hover {
    color: white;
    background: #00a85a;
}

QPushButton#statisticsButton {
    color: #006bdc;
    background: white;
    border: 1px solid #9fc4ff;
    padding: 7px 18px;
}

QPushButton#statisticsButton:hover {
    color: white;
    background: #0b72e7;
}

QPushButton#addButton {
    color: white;
    background: #e00000;
    border: 2px solid #e00000;
    padding: 7px 12px;
}

QPushButton#addButton:hover {
    background: #b90000;
}

QPushButton[class=&quot;outlineRed&quot;] {
    color: #ff1414;
    background: white;
    border: 2px solid #ff1414;
    padding: 7px 12px;
}

QPushButton[class=&quot;outlineRed&quot;]:hover {
    color: white;
    background: #ff1414;
}

QPushButton[class=&quot;smallButton&quot;] {
    color: #ff1515;
    background: white;
    border: 1px solid #ffc7c7;
    padding: 5px 14px;
}

QPushButton[class=&quot;smallButton&quot;]:hover {
    color: white;
    background: #ff1515;
}

QTableWidget {
    border: none;
    gridline-color: #edf0f5;
    background: white;
    font-size: 11px;
    font-weight: bold;
}

QHeaderView::section {
    color: #526070;
    background: white;
    border: none;
    padding: 8px;
    font-size: 10px;
    font-weight: bold;
}

QLabel#redAlert {
    color: #ff1515;
    background: #ffe1e1;
    border-radius: 7px;
    padding: 10px;
    font-weight: bold;
}

QLabel#blueAlert {
    color: #076ee7;
    background: #e3f0ff;
    border-radius: 7px;
    padding: 10px;
    font-weight: bold;
}

QLabel[class=&quot;placeholderTitle&quot;] {
    color: #d80000;
    font-size: 28px;
    font-weight: bold;
}

QLabel[class=&quot;metricCard&quot;] {
    background: white;
    border: 1px solid #e2e7ef;
    border-radius: 8px;
    padding: 12px;
    font-size: 14px;
    font-weight: bold;
}

QProgressBar {
    min-height: 18px;
    border: none;
    border-radius: 8px;
    background: #edf0f5;
    text-align: center;
    font-weight: bold;
}

QProgressBar::chunk {
    border-radius: 8px;
    background: #ff3333;
}
